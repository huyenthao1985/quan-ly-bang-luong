import React, { useState } from 'react';
import { Calendar, Zap, Save, CheckCircle, Search, Filter } from 'lucide-react';
import { usePayroll } from '../../context/PayrollContext';
import { Employee } from '../../types/payroll';

export const AttendanceTab: React.FC = () => {
  const {
    employees,
    attendanceRecords,
    selectedMonth,
    selectedYear,
    setSelectedMonth,
    setSelectedYear,
    updateAttendanceDay,
    quickFillAttendanceMonth,
    showToast,
  } = usePayroll();

  const [searchTerm, setSearchTerm] = useState('');
  const [selectedDept, setSelectedDept] = useState<string>('ALL');
  const [selectedDay, setSelectedDay] = useState<number>(1);

  const daysInMonth = new Date(selectedYear, selectedMonth, 0).getDate();
  const dateFormatted = `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-${selectedDay < 10 ? '0' + selectedDay : selectedDay}`;

  const departments = ['ALL', ...Array.from(new Set(employees.map((e) => e.department)))];

  const filteredEmployees = employees.filter((emp) => {
    const matchesSearch =
      emp.fullName.toLowerCase().includes(searchTerm.toLowerCase()) ||
      emp.id.includes(searchTerm);
    const matchesDept = selectedDept === 'ALL' || emp.department === selectedDept;
    return matchesSearch && matchesDept;
  });

  const handleQuickFill = () => {
    quickFillAttendanceMonth();
  };

  return (
    <div className="space-y-4">
      {/* Top Selector & Quick Action Bar */}
      <div className="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center gap-3 flex-wrap">
          <div className="flex items-center gap-2 bg-slate-50 dark:bg-slate-900 px-3 py-1.5 rounded border border-slate-200 dark:border-slate-700">
            <Calendar className="w-4 h-4 text-blue-600" />
            <span className="text-xs font-semibold text-slate-700 dark:text-slate-300">
              Kỳ chấm công:
            </span>
            <select
              value={selectedMonth}
              onChange={(e) => setSelectedMonth(Number(e.target.value))}
              className="bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded px-2 py-1 text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer"
            >
              {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
                <option key={m} value={m}>
                  Tháng {m}
                </option>
              ))}
            </select>
            <select
              value={selectedYear}
              onChange={(e) => setSelectedYear(Number(e.target.value))}
              className="bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded px-2 py-1 text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer"
            >
              {[2025, 2026, 2027].map((y) => (
                <option key={y} value={y}>
                  {y}
                </option>
              ))}
            </select>
          </div>

          <div className="flex items-center gap-2">
            <Search className="w-3.5 h-3.5 text-slate-400" />
            <input
              type="text"
              placeholder="Lọc NV theo tên hoặc Mã NV..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-800 dark:text-slate-200"
            />
          </div>
        </div>

        <button
          onClick={handleQuickFill}
          className="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-4 py-2 rounded shadow-sm transition-all cursor-pointer"
        >
          <Zap className="w-4 h-4 fill-emerald-200" />
          <span>⚡ Điền tự động tháng {selectedMonth}/{selectedYear}</span>
        </button>
      </div>

      {/* Daily Timekeeping Matrix Table */}
      <div className="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-x-auto">
        <div className="p-3 bg-slate-100 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
          <h3 className="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
            Bảng nhập điểm danh & Giờ làm việc chi tiết
          </h3>
          <span className="text-[11px] text-slate-500">
            * Nhập trực tiếp số giờ HC (Hành chính) và giờ tăng ca (OT/Đêm/CN) cho từng nhân viên
          </span>
        </div>

        <table className="w-full text-xs border-collapse text-left">
          <thead className="bg-[#122842] text-white uppercase text-[11px] font-bold">
            <tr>
              <th className="py-2.5 px-3 border-r border-slate-700/60 sticky left-0 bg-[#122842] z-10 w-28">Mã NV</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 sticky left-28 bg-[#122842] z-10 min-w-[140px]">Họ tên</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-16">HC (h)</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-16">OT 150%</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-16">Đêm 30%</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-16">CN 200%</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-16">Lễ 300%</th>
              <th className="py-2.5 px-3 border-r border-slate-700/60 text-center w-20">Nghỉ Lương</th>
              <th className="py-2.5 px-3 text-center w-20">Nghỉ Phép</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-200 dark:divide-slate-700/60">
            {filteredEmployees.map((emp) => {
              const key = `${emp.id}_${selectedYear}_${selectedMonth}`;
              const record = attendanceRecords[key];

              let totalHc = 0;
              let totalOt = 0;
              let totalNight = 0;
              let totalSunday = 0;
              let totalHoliday = 0;
              let totalLeavePaid = 0;
              let totalLeaveAnnual = 0;

              if (record && record.dailyRecords) {
                Object.values(record.dailyRecords).forEach((d) => {
                  totalHc += d.hcHours || 0;
                  totalOt += d.otHours || 0;
                  totalNight += d.nightHours || 0;
                  totalSunday += d.sundayHours || 0;
                  totalHoliday += d.holidayHours || 0;
                  totalLeavePaid += d.leavePaidDays || 0;
                  totalLeaveAnnual += d.leaveAnnualDays || 0;
                });
              }

              return (
                <tr key={emp.id} className="hover:bg-blue-50/40 dark:hover:bg-slate-700/40">
                  <td className="py-2 px-3 font-semibold text-slate-700 dark:text-slate-300 sticky left-0 bg-white dark:bg-slate-800 z-10 border-r border-slate-200 dark:border-slate-700">
                    {emp.id}
                  </td>
                  <td className="py-2 px-3 font-bold text-slate-900 dark:text-slate-100 sticky left-28 bg-white dark:bg-slate-800 z-10 border-r border-slate-200 dark:border-slate-700">
                    {emp.fullName}
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-800 dark:text-slate-200 font-semibold focus:ring-1 focus:ring-blue-500"
                      value={totalHc}
                      onChange={(e) => {
                        // Quick update for first day as reference
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'hcHours', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700 rounded text-amber-900 dark:text-amber-200 font-semibold focus:ring-1 focus:ring-amber-500"
                      value={totalOt}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'otHours', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-300 dark:border-indigo-700 rounded text-indigo-900 dark:text-indigo-200 font-semibold"
                      value={totalNight}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'nightHours', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-red-50 dark:bg-red-950/40 border border-red-300 dark:border-red-700 rounded text-red-900 dark:text-red-200 font-semibold"
                      value={totalSunday}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'sundayHours', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-purple-50 dark:bg-purple-950/40 border border-purple-300 dark:border-purple-700 rounded text-purple-900 dark:text-purple-200 font-semibold"
                      value={totalHoliday}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'holidayHours', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center border-r border-slate-200 dark:border-slate-700">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-800 dark:text-slate-200"
                      value={totalLeavePaid}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'leavePaidDays', Number(e.target.value));
                      }}
                    />
                  </td>
                  <td className="py-2 px-3 text-center">
                    <input
                      type="number"
                      step="0.5"
                      className="w-14 text-center py-1 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-800 dark:text-slate-200"
                      value={totalLeaveAnnual}
                      onChange={(e) => {
                        updateAttendanceDay(emp.id, `${selectedYear}-${selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}-01`, 'leaveAnnualDays', Number(e.target.value));
                      }}
                    />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
};
